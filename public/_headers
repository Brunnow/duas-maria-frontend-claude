# Cache no navegador (Cloudflare Workers Static Assets).
# /assets/* tem hash no nome (o Vite troca a cada build): pode guardar 1 ano.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fotos da capa: o nome leva a versão (-v1). Ao trocar a arte, suba com -v2
# e atualize Hero.jsx e o pré-carregamento do index.html.
/hero/*
  Cache-Control: public, max-age=31536000, immutable
