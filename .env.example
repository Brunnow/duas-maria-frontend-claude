# URL base da API do backend (Spring Boot). Sem barra final.
# O cliente Axios (src/api/api.js) usa este valor + "/api".
VITE_BACK_END_URL=http://localhost:8080

# Pixel da Meta (Facebook/Instagram Ads). É público, não é segredo.
# Vazio = Pixel desligado (nenhum script carregado, nenhum evento).
VITE_META_PIXEL_ID=4454956584769897
# Em dev (npm run dev) o Pixel não dispara; para testar com o Meta Pixel Helper, descomente no .env.local:
# VITE_META_PIXEL_DEBUG=true
